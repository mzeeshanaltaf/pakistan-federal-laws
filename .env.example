# Existing VPS Postgres 17.7 + pgvector, schema `pak_laws`. See docs/plan/phase-1-storage-schema.md.
DATABASE_URL=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBED_MODEL=text-embedding-3-small

# MinIO on the VPS, private "laws" bucket, accessed via the S3 API — provisioned in Phase 1.
# Required even though MinIO isn't AWS: @aws-sdk/client-s3 talks to it over this API regardless of host.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Upstash Redis — per-IP rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
